# Render Environment Variables Example
# Copy these keys into: Render Dashboard -> Environment -> Environment Variables

# Supabase Session Pooler (IPv4 address, port 5432).
# Do not use direct db.<project>.supabase.co because Render free instances require IPv4.
DATABASE_URL=postgresql://postgres.bxnbeatlldxurigjphml:<YOUR_DATABASE_PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Set to "supabase" to upload inspection photos to the Supabase storage bucket.
STORAGE_BACKEND=supabase

# Supabase project URL.
SUPABASE_URL=https://bxnbeatlldxurigjphml.supabase.co

# Supabase anon or service-role API key.
SUPABASE_KEY=<YOUR_SUPABASE_ANON_OR_SERVICE_KEY>

# Name of the public storage bucket.
SUPABASE_BUCKET=audit-images

# Google Gemini API key for Tier-3 Cloud VLM Second-Verification.
# Uses gemini-3.8-flash (with fallback to gemini-4-hydrogen).
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
